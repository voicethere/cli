{
  "name": "@voicethere/cli",
  "version": "0.12.8",
  "description": "VoiceThere cloud CLI — login, projects, and agent bundle upload",
  "type": "module",
  "bin": {
    "voicethere": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:ci": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voicethere/cli.git"
  },
  "bugs": {
    "url": "https://github.com/voicethere/cli/issues"
  },
  "homepage": "https://voicethere.io",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "voicethere",
    "voice-agent",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@voicethere/agent": "0.5.3",
    "commander": "13.1.0",
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
